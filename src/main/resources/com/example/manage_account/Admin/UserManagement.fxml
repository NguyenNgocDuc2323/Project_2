<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.UserManagementController"
            style="-fx-background-color: #f5f0e8; -fx-background-radius: 10;">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <!-- Title Section -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #6f4e37; -fx-background-radius: 5; -fx-padding: 10;">
                    <Label text="User Management" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #f8f1e5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0.5, 1, 1);"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddButton" text="Add User"
                            style="-fx-background-color: #8d6e63; -fx-text-fill: white; -fx-padding: 8px 16px; -fx-background-radius: 20px; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0, 1, 1);"/>
                    <Button fx:id="editButton" mnemonicParsing="false" onAction="#handleEditButton" text="Edit User"
                            style="-fx-background-color: #a1887f; -fx-text-fill: white; -fx-padding: 8px 16px; -fx-background-radius: 20px; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0, 1, 1);"/>
                    <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDeleteButton" text="Delete User"
                            style="-fx-background-color: #bcaaa4; -fx-text-fill: white; -fx-padding: 8px 16px; -fx-background-radius: 20px; -fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0, 1, 1);"/>
                </HBox>

                <!-- Table Section -->
                <TableView fx:id="userTableView" VBox.vgrow="ALWAYS"
                           style="-fx-border-color: #6f4e37; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-color: #ffffff; -fx-font-size: 14px; -fx-text-fill: #5c3d2e; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" style="-fx-font-weight: bold; -fx-text-fill: #5c3d2e; -fx-alignment: CENTER;"/>
                        <TableColumn fx:id="fullNameColumn" prefWidth="150.0" text="Full Name" style="-fx-font-weight: bold; -fx-text-fill: #5c3d2e; -fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="emailColumn" prefWidth="150.0" text="Email" style="-fx-font-weight: bold; -fx-text-fill: #5c3d2e; -fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="passwordColumn" prefWidth="150.0" text="Password" style="-fx-font-weight: bold; -fx-text-fill: #5c3d2e; -fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Role" style="-fx-font-weight: bold; -fx-text-fill: #5c3d2e; -fx-alignment: CENTER;"/>
                        <TableColumn fx:id="lockStatusColumn" prefWidth="100.0" text="Status" style="-fx-font-weight: bold; -fx-text-fill: #5c3d2e; -fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <style>
                        -fx-table-cell-border-color: transparent;
                        -fx-table-header-border-color: #6f4e37;
                        -fx-selection-bar: #d7ccc8;
                        -fx-selection-bar-non-focused: #efebe9;
                    </style>
                </TableView>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>
            <style>
                -fx-background-color: #f5f0e8;
                -fx-background-radius: 10;
                -fx-border-color: #6f4e37;
                -fx-border-width: 2;
                -fx-border-radius: 10;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 0);
            </style>
        </VBox>
    </children>
</AnchorPane>