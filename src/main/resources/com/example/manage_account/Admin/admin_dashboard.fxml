<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.shape.Circle?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.admin.DashboardController"
            stylesheets="@../../../../assets/styles/dashboard.css"
            prefWidth="1200"
            prefHeight="800">
    <!-- Left Navigation Bar -->
    <left>
        <VBox fx:id="sideNav" styleClass="side-nav" prefWidth="240" spacing="15">
            <!-- App Logo -->
            <StackPane styleClass="logo-container" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="20" right="15" bottom="30" left="15" />
                </padding>
                <ImageView fx:id="logoImage" fitWidth="40" fitHeight="40" preserveRatio="true">
                    <image>
                        <Image url="@../../../../assets/images/Logo/logo_1.png" />
                    </image>
                </ImageView>
                <Label text="The 90s Brew" styleClass="logo-text">
                    <font>
                        <Font name="System Bold" size="18" />
                    </font>
                    <StackPane.margin>
                        <Insets left="50" />
                    </StackPane.margin>
                </Label>
            </StackPane>

            <VBox spacing="10" styleClass="nav-items" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="10" right="15" bottom="10" left="15" />
                </padding>

                <Button fx:id="menuBtn" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@../images/menu-icon.png" />
                                </image>
                            </ImageView>
                            <Label text="Home Page" styleClass="nav-text" />
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15" />
                    </padding>
                </Button>

                <Button fx:id="tableBtn" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@../images/cart-icon.png" />
                                </image>
                            </ImageView>
                            <Label text="Table" styleClass="nav-text" />
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15" />
                    </padding>
                </Button>

                <Button fx:id="historyBtn" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@../images/history-icon.png" />
                                </image>
                            </ImageView>
                            <Label text="Orders" styleClass="nav-text" />
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15" />
                    </padding>
                </Button>

                <Button fx:id="profileBtn" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@../images/profile-icon.png" />
                                </image>
                            </ImageView>
                            <Label text="Profile" styleClass="nav-text" />
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15" />
                    </padding>
                </Button>

                <VBox.margin>
                    <Insets bottom="20" />
                </VBox.margin>
            </VBox>

            <!-- User Info at Bottom -->
            <VBox styleClass="user-info">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15" />
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle fx:id="userAvatar" radius="20" styleClass="user-avatar" />
                        <Label fx:id="userInitialsLabel" styleClass="avatar-initials" text="JD" />
                    </StackPane>
                    <VBox>
                        <Label fx:id="userNameLabel" text="Loading..." styleClass="user-name" />
                        <Label fx:id="userRoleLabel" text="Loading..." styleClass="user-role" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="logoutBtn" styleClass="logout-button" onAction="#handleSignOut">
                        <graphic>
                            <ImageView fitWidth="18" fitHeight="18">
                                <image>
                                    <Image url="@../images/logout.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Toggle Button for Collapsing Sidebar -->
            <Button fx:id="toggleNavBtn" styleClass="toggle-button">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@../images/collapse-icon.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll" hbarPolicy="NEVER">
            <StackPane fx:id="contentArea" styleClass="content-area">
                <!-- This is where different views will be loaded dynamically -->
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>