<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="500.0" prefWidth="1000.0" stylesheets="@../../../../assets/styles/styles.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.staff.OrderStatisticController">
   <center>
       <VBox spacing="16.0">
           <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Order Statistic">
              <font>
                  <Font size="24.0" />
              </font>
              <VBox.margin>
                  <Insets left="16.0" top="16.0" />
              </VBox.margin>
           </Text>
           <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="80.0">
            <VBox alignment="CENTER_LEFT">
               <children>
                      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Total Order Count">
                          <font>
                              <Font name="System Bold" size="13.0" />
                          </font>
                      </Text>
                      <Text fx:id="totalOrderCount" />
               </children>
            </VBox>
            <VBox alignment="CENTER_LEFT">
               <children>
                      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Total Revenue">
                          <font>
                              <Font name="System Bold" size="13.0" />
                          </font>
                      </Text>
                      <Text fx:id="totalRevenue" />
               </children>
            </VBox>
           </HBox>
           <TabPane tabClosingPolicy="UNAVAILABLE">
               <Tab closable="false" text="Monthly">
                   <TableView fx:id="orderMonthlyStatisticTable" prefHeight="400" prefWidth="600">
                       <columns>
                           <TableColumn fx:id="monthlyYearColumn" prefWidth="100" text="Year" />
                           <TableColumn fx:id="monthlyMonthColumn" prefWidth="100" text="Month" />
                           <TableColumn fx:id="monthlyOrderCountColumn" prefWidth="150" text="Order Count" />
                           <TableColumn fx:id="monthlyRevenueColumn" prefWidth="150" text="Revenue" />
                       </columns>
                       <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                       </columnResizePolicy>
                   </TableView>
               </Tab>
               <Tab closable="false" text="Weekly">
                   <TableView fx:id="orderWeeklyStatisticTable" prefHeight="400" prefWidth="600">
                       <columns>
                           <TableColumn fx:id="weeklyYearColumn" prefWidth="100" text="Year" />
                           <TableColumn fx:id="weeklyMonthColumn" prefWidth="100" text="Month" />
                           <TableColumn fx:id="weeklyWeekColumn" prefWidth="100" text="Week" />
                           <TableColumn fx:id="weeklyOrderCountColumn" prefWidth="150" text="Order Count" />
                           <TableColumn fx:id="weeklyRevenueColumn" prefWidth="150" text="Revenue" />
                       </columns>
                       <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                       </columnResizePolicy>
                   </TableView>
               </Tab>
               <Tab closable="false" text="Daily">
                   <TableView fx:id="orderDailyStatisticTable" prefHeight="400" prefWidth="600">
                       <columns>
                           <TableColumn fx:id="dailyYearColumn" prefWidth="100" text="Year" />
                           <TableColumn fx:id="dailyMonthColumn" prefWidth="100" text="Month" />
                           <TableColumn fx:id="dailyDayColumn" prefWidth="100" text="Day" />
                           <TableColumn fx:id="dailyOrderCountColumn" prefWidth="150" text="Order Count" />
                           <TableColumn fx:id="dailyRevenueColumn" prefWidth="150" text="Revenue" />
                       </columns>
                       <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                       </columnResizePolicy>
                   </TableView>
               </Tab>
           </TabPane>
       </VBox>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
