<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="500.0" prefWidth="1000.0" styleClass="surface-container" stylesheets="@../../../../assets/styles/styles.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.staff.CategoryController">
    <left>
        <fx:include source="Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16.0" styleClass="surface">
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <VBox alignment="CENTER_LEFT" spacing="16.0">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Category Management">
                    <font>
                        <Font size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </Text>
                <HBox alignment="CENTER_LEFT" spacing="40.0">
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                    <Button fx:id="createButton" onAction="#handleCreate" text="Create Category" />
                    <Button fx:id="updateButton" onAction="#handleUpdate" text="Update Category" />
                    <Button fx:id="deleteButton" onAction="#handleDelete" text="Delete Category" />
                </HBox>
            </VBox>
            <TableView fx:id="categoryTable">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="127.0" text="Category Id" />
                    <TableColumn fx:id="nameColumn" prefWidth="174.0" text="Name" />
                    <TableColumn fx:id="descriptionColumn" prefWidth="360.0" text="Description" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
        </VBox>
    </center>
</BorderPane>
