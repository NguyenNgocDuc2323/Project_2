<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.staff.TableController">
    <top>
        <HBox alignment="CENTER" prefHeight="50.0" spacing="5.0" BorderPane.alignment="CENTER">
            <Label text="Filter by Floor:">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            <ComboBox fx:id="floorFilterComboBox" onAction="#handleFilterByFloor" promptText="None"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="100.0" text="Table Id" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Table Name" />
                <TableColumn fx:id="capacityColumn" prefWidth="100.0" text="Capacity" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="floorColumn" prefWidth="100.0" text="Floor Number" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <FlowPane alignment="CENTER" hgap="50.0" prefHeight="100.0">
            <Button fx:id="createButton" onAction="#handleCreateTable" text="Create Table">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
            <Button fx:id="updateButton" onAction="#handleUpdateTable" text="Update Table">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
            <Button fx:id="deleteButton" onAction="#handleDeleteTable" text="Delete Table">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
        </FlowPane>
    </bottom>
</BorderPane>
