<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="500.0" prefWidth="1000.0" stylesheets="@../../../../assets/styles/styles.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.staff.TableController">
    <top>
        <VBox alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
         <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Table Management">
            <font>
               <Font size="24.0" />
            </font>
            <VBox.margin>
               <Insets />
            </VBox.margin>
         </Text>
            <HBox alignment="CENTER_LEFT" spacing="40.0">
                <VBox.margin>
                    <Insets top="16.0"/>
                </VBox.margin>
                <Button fx:id="createButton" onAction="#handleCreateTable" text="Create Table"/>
                <Button fx:id="updateButton" onAction="#handleUpdateTable" text="Update Table"/>
                <Button fx:id="deleteButton" onAction="#handleDeleteTable" text="Delete Table"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <HBox alignment="CENTER" spacing="8.0">
                    <Label text="Filter by Floor:"/>
                    <ComboBox fx:id="floorFilterComboBox" onAction="#handleFilterByFloor" promptText="None"/>
                </HBox>
                <VBox.margin>
                    <Insets top="16.0" />
                </VBox.margin>
            </HBox>
         <BorderPane.margin>
            <Insets left="16.0" top="16.0" />
         </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tableTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="100.0" text="Table Id" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Table Name" />
                <TableColumn fx:id="capacityColumn" prefWidth="100.0" text="Capacity" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="floorColumn" prefWidth="100.0" text="Floor Number" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         <BorderPane.margin>
            <Insets top="16.0" />
         </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
