<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane stylesheets="@../../../../assets/styles/styles.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.staff.OrderDetailController">
    <center>
        <VBox spacing="16.0">
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <VBox alignment="CENTER_LEFT" spacing="16.0">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Order Detail Management">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>
                <HBox alignment="CENTER_LEFT" spacing="40.0">
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                    <Button onAction="#handleCreateOrderDetail" text="Create Order Detail" />
                    <Button onAction="#handleUpdateOrderDetail" text="Update Product and Quantity" />
                    <Button onAction="#handleBackToOrder" text="Back To Order" />
                </HBox>
            </VBox>
            <TableView fx:id="orderDetailTable">
                <columns>
                    <TableColumn fx:id="orderDetailIdColumn" text="Order Detail Id" />
                    <TableColumn fx:id="orderIdColumn" text="Order Id" />
                    <TableColumn fx:id="productNameColumn" text="Product" />
                    <TableColumn fx:id="quantityColumn" text="Quantity" />
                    <TableColumn fx:id="unitPriceColumn" text="Unit Price" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
        </VBox>
    </center>
</BorderPane>
