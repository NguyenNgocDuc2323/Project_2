<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>

<VBox spacing="20" styleClass="profile-container" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CoffeeShop.ProfileViewController"
      stylesheets="@../../../../assets/styles/profile.css">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox alignment="CENTER">
        <StackPane styleClass="profile-picture-container">
            <Circle fx:id="profilePicCircle" radius="50" styleClass="profile-picture" />
            <Label fx:id="initialsLabel" styleClass="initials-label" />
        </StackPane>
    </HBox>

    <VBox alignment="CENTER" spacing="5">
        <Label fx:id="welcomeLabel" text="Welcome back!" styleClass="welcome-text"/>
        <Label fx:id="userNameLabel" text="User Name" styleClass="user-name">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
    </VBox>

    <GridPane vgap="15" hgap="15" styleClass="profile-details">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="150" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="200" prefWidth="250" />
        </columnConstraints>

        <Label text="Email:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <Label fx:id="emailLabel" text="Loading..." styleClass="field-value" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Account Type:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <Label fx:id="accountTypeLabel" text="Loading..." styleClass="field-value" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Account Status:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <HBox alignment="CENTER_LEFT" spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <Circle fx:id="statusIndicator" radius="6" styleClass="status-active"/>
            <Label fx:id="statusLabel" text="Active" styleClass="status-text"/>
        </HBox>
    </GridPane>

    <VBox fx:id="passwordChangeForm" spacing="15" styleClass="password-form">
        <Label text="Change Your Password" styleClass="section-title">
            <font>
                <Font name="System Bold" size="16.0"/>
            </font>
        </Label>

        <GridPane vgap="15" hgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="150" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="200" prefWidth="250" />
            </columnConstraints>

            <Label text="Current Password:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <PasswordField fx:id="currentPasswordField" styleClass="password-field"
                           promptText="Enter current password" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="New Password:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <PasswordField fx:id="newPasswordField" styleClass="password-field"
                           promptText="Enter new password" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Confirm Password:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <PasswordField fx:id="confirmPasswordField" styleClass="password-field"
                           promptText="Confirm new password" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        </GridPane>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="Cancel" styleClass="cancel-button" />
            <Button fx:id="updatePasswordButton" text="Update Password" styleClass="update-button" />
        </HBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="signOutButton" text="Sign Out" styleClass="sign-out-button" />
    </HBox>
</VBox>