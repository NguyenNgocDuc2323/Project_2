<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" styleClass="combo-item" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CoffeeShop.ComboItemController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <ImageView fx:id="imageView" fitHeight="150" fitWidth="150" preserveRatio="true"/>

    <Label fx:id="discountLabel" styleClass="discount-label"/>

    <Label fx:id="nameLabel" styleClass="combo-name-label"/>

    <Label fx:id="descriptionLabel" styleClass="combo-description-label" wrapText="true"/>

    <Label fx:id="productsLabel" styleClass="combo-products-label" wrapText="true"/>

    <HBox alignment="CENTER" spacing="10">
        <Label fx:id="priceLabel" styleClass="combo-price-label"/>
        <Button fx:id="addToCartButton" text="Add to Cart" styleClass="add-to-cart-button"/>
    </HBox>
</VBox>