<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.ComboDialogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Thông Tin Combo" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="300.0" />
            </columnConstraints>

            <Label text="Tên Combo:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Mô tả:" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP" />
            <TextArea fx:id="descriptionArea" prefHeight="60.0" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Giảm giá (%):" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="discountPercentField" text="5.0" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Trạng thái:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <ComboBox fx:id="statusComboBox" prefWidth="150.0" GridPane.rowIndex="3" GridPane.columnIndex="1" />
        </GridPane>

        <Separator />

        <Label text="Sản Phẩm Trong Combo" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

        <HBox spacing="10" VBox.vgrow="ALWAYS">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Sản phẩm có sẵn:" />
                <TableView fx:id="availableProductsTable" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="availableNameColumn" prefWidth="150.0" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="availablePriceColumn" prefWidth="100.0" text="Giá" />
                    </columns>
                </TableView>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Button fx:id="addProductButton" text="&gt;&gt;" />
                <Button fx:id="removeProductButton" text="&lt;&lt;" />
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Sản phẩm đã chọn:" />
                <TableView fx:id="selectedProductsTable" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="selectedNameColumn" prefWidth="150.0" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="selectedPriceColumn" prefWidth="100.0" text="Giá" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <GridPane hgap="10" vgap="5">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
            </columnConstraints>

            <Label text="Tổng giá gốc:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="originalPriceLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Giá sau giảm:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="finalPriceLabel" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="saveButton" onAction="#handleSave" text="Lưu" />
            <Button fx:id="cancelButton" onAction="#handleCancel" text="Hủy" />
        </HBox>
    </children>
</VBox>