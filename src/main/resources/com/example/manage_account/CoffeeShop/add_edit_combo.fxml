<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.admin.ComboDialogController" style="-fx-padding: 20;">
    <GridPane vgap="10" hgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        
        <Label text="Tên combo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="Mô tả:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="3" 
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <Label text="Giá combo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        
        <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="statusComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    
    <Separator />
    
    <Label text="Thêm sản phẩm vào combo" style="-fx-font-weight: bold" />
    <GridPane vgap="10" hgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="NEVER" />
            <ColumnConstraints hgrow="NEVER" />
        </columnConstraints>
        
        <ComboBox fx:id="productComboBox" promptText="Chọn sản phẩm" 
                  GridPane.columnIndex="0" />
        <ComboBox fx:id="sizeComboBox" promptText="Chọn kích thước" 
                  GridPane.columnIndex="1" />
        <Spinner fx:id="quantitySpinner" prefWidth="100" 
                 GridPane.columnIndex="2" />
        <Button text="Thêm" onAction="#handleAddProduct" 
                GridPane.columnIndex="3" />
    </GridPane>
    
    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="productNameColumn" text="Tên sản phẩm" />
            <TableColumn fx:id="productSizeColumn" text="Kích thước" />
            <TableColumn fx:id="productQuantityColumn" text="Số lượng" />
            <TableColumn fx:id="productPriceColumn" text="Đơn giá" />
            <TableColumn fx:id="productTotalColumn" text="Thành tiền" />
            <TableColumn fx:id="productActionColumn" text="Thao tác" />
        </columns>
    </TableView>
    
    <GridPane vgap="5" hgap="10">
        <Label text="Tổng giá gốc:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="originalPriceLabel" text="0đ" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="Tiết kiệm:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="savingsLabel" text="0%" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Lưu" onAction="#handleSave" styleClass="primary-button" />
        <Button text="Hủy" onAction="#handleCancel" />
    </HBox>
</VBox>