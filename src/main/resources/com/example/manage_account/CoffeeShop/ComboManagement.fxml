<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.ComboManagementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="page-title" text="Quản lý Combo Sản Phẩm" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        </HBox>
        
        <TableView fx:id="comboTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Tên Combo" />
                <TableColumn fx:id="originalPriceColumn" prefWidth="120.0" text="Giá Gốc" />
                <TableColumn fx:id="discountPercentColumn" prefWidth="100.0" text="Giảm Giá (%)" />
                <TableColumn fx:id="finalPriceColumn" prefWidth="120.0" text="Giá Cuối" />
                <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Trạng Thái" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="addButton" onAction="#handleAddButton" text="Thêm Combo" />
            <Button fx:id="editButton" onAction="#handleEditButton" text="Sửa Combo" />
            <Button fx:id="deleteButton" onAction="#handleDeleteButton" text="Xóa Combo" />
        </HBox>
    </children>
</VBox>