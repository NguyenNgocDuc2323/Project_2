<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.CoffeeDialogController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <Label text="Coffee Details" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="100.0" prefWidth="120.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Name:" />
                        <TextField fx:id="nameField" GridPane.columnIndex="1" />

                        <Label text="Category:" GridPane.rowIndex="1" />
                        <ComboBox fx:id="categoryComboBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Price:" GridPane.rowIndex="2" />
                        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Quantity:" GridPane.rowIndex="3" />
                        <TextField fx:id="quantityField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Description:" GridPane.rowIndex="4" />
                        <TextArea fx:id="descriptionArea" prefHeight="100.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                </GridPane>

                <VBox spacing="10.0">
                    <Label text="Image:" />
                    <HBox spacing="10.0">
                        <ImageView fx:id="coffeeImageView" fitHeight="150.0" fitWidth="200.0" preserveRatio="true" />
                        <Button fx:id="browseImageButton" mnemonicParsing="false" onAction="#handleBrowseImage" text="Browse..." />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Cancel" />
                    <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSave" text="Save" />
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>